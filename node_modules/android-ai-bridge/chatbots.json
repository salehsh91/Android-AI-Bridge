{
  "chatgpt": {
    "inputbox": "#prompt-textarea",
    "btnsend": "#composer-submit-button",
    "btnnosend": "button[data-testid='stop-button']",
    "textbox": "[data-message-author-role='assistant'] .markdown",
    "imgbox": ".markdown img",
    "boximg": ".markdown div:has(> img)",
    "url": "https://chatgpt.com/",
    "error": {
      "errorbox": ".text-token-textError",
      "handelbtn": "button[aria-label*='Regenerate']"
    },
    "options": "none",
    "loginsetting": {
      "btnprofile": "[data-testid='profile-button'], [aria-label='Profile']",
      "btnspanel": "[role='menuitem']",
      "btnlength": -1,
      "btnloginpanel": "a[href*='auth/login']",
      "inpemail": "input#username",
      "inppass": "input#password",
      "btnlogin": "button[type='submit']",
      "twostep": true
    }
  },

  
  "deepseek": {
    "inputbox": "textarea[placeholder='Message DeepSeek']",
    "btnsend": "div[role='button'].ds-button--primary",
    "btnnosend": ".ds-button--disabled",
    "textbox": "div.ds-message:has(.ds-markdown)",
    "imgbox": "none",
    "boximg": "none",
    "url": "https://chat.deepseek.com/",
    "error": {
      "errorbox": "none",
      "handelbtn": "div.ds-icon-button"
    },
    "options": "none",
    "loginsetting": {
      "btnprofile": "[class*='avatar']",
      "btnspanel": "[role='menuitem']",
      "btnlength": -1,
      "btnloginpanel": "button.ds-button--primary",
      "inpemail": "input[autocomplete='email'], input[type='email'], input[placeholder*='mail']",
      "inppass": "input[autocomplete='current-password'], input[type='password']",
      "btnlogin": "button.ds-button--primary[type='submit'], .ds-sign-in-form__main button.ds-button--primary"
    }
  },

  "qwen": {
    "inputbox": "textarea.message-input-textarea",
    "btnsend": ".send-button",
    "btnnosend": "button.send-button.disabled",
    "textbox": ".response-message-content",
    "imgbox": "img.qwen-image",
    "boximg": ".qwen-markdown-image",
    "url": "https://chat.qwen.ai/",
    "error": {
      "errorbox": ".qwen-messsage-status",
      "handelbtn": ".qwen-chat-package-comp-new-action-control-container.qwen-chat-package-comp-new-action-control-container-regenerate"
    },
    "options": {
      "btnplus": "div.mode-select-open",
      "btnoptions": "li.ant-dropdown-menu-item",
      "btnclose": ".mode-select-current-mode-close",
      "imgoptions": {
        "btnselector": 2,
        "models": "none",
        "aspect_ratio": "none"
      }
    },
    "loginsetting": {
      "btnprofile": ".user-menu-btn",
      "btnspanel": ".user-menu-dropdown-item-text",
      "btnlength": -1,
      "btnloginpanel": ".header-right-auth-button.brandprimary",
      "inpemail": "[name='email']",
      "inppass": "[name='password']",
      "btnlogin": "button.qwen-chat-btn[type='submit']"
    }
  }
}